<h1>Nuevo Acuerdo</h1>

<%= form_with model: @acuerdo, local: true, multipart: true do |f| %>
  <% if @acuerdo.errors.any? %>
    <div id="error_explanation" style="color: red;">
      <h2><%= pluralize(@acuerdo.errors.count, "error") %> impidieron crear el acuerdo:</h2>
      <ul>
        <% @acuerdo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "Nombre del Acuerdo" %><br>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= f.label :file, "Archivo (PDF, DOCX, etc.)" %><br>
    <%= f.file_field :file, required: true %>
  </div>

  <div class="field">
    <%= f.label :user_ids, "Seleccionar usuarios firmantes" %><br>
    <%= f.collection_select :user_ids, User.all, :id, :name, {}, multiple: true, size: 5 %>
    <p style="font-size: 0.9em; color: gray;">(Puedes seleccionar varios manteniendo presionada la tecla Ctrl o Cmd)</p>
  </div>

  <div class="field">
    <%= f.label :firmar_creador, "¿El creador también firmará este acuerdo?" %><br>
    <%= f.check_box :firmar_creador, {}, '1', '0' %>
  </div>

  <div class="actions">
    <%= f.submit "Crear Acuerdo", class: "btn btn-primary" %>
  </div>
<% end %>

