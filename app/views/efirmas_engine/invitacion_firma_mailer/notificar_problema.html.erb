<div class="content">
  <p>Hola <%= @creador.name %>,</p>
  
  <p>Se ha reportado un problema en el acuerdo <strong><%= @acuerdo.name %></strong>.</p>
  
  <div class="alert">
    <p><strong>Motivo del reporte:</strong></p>
    <p><%= @comentario.motivo %></p>
    
    <% if @comentario.comentario.present? %>
      <p><strong>Comentario adicional:</strong></p>
      <p><%= @comentario.comentario %></p>
    <% end %>
  </div>
  
  <p>Puedes revisar el acuerdo y atender el reporte desde el siguiente enlace:</p>
  <a href="<%= @url_acuerdo %>" class="button">Revisar acuerdo</a>
  
  <p>Este aviso fue generado automáticamente cuando un usuario reportó un problema con el acuerdo.</p>
</div>

<div class="footer">
