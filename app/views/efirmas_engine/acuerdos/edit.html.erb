<h1>Editar Acuerdo</h1>


<% if @acuerdo.comentario_acuerdos.any? %>
  <div class="alert alert-info">
    <h5>Problemas reportados:</h5>
    <ul class="mb-0">
      <% @acuerdo.comentario_acuerdos.recientes.limit(3).each do |comentario| %>
        <li><strong><%= comentario.motivo %></strong> - <%= comentario.comentario.truncate(100) %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card p-4 shadow-sm">
  <%= form_with model: @acuerdo, local: true, multipart: true do |f| %>
    <% if @acuerdo.errors.any? %>
      <div class="alert alert-danger">
        <h5><%= pluralize(@acuerdo.errors.count, "error") %> impidieron actualizar el acuerdo:</h5>
        <ul class="mb-0">
          <% @acuerdo.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, "Nombre del Acuerdo", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true %>
      <small class="form-text text-muted">Valor actual: <strong><%= @acuerdo.name %></strong></small>
    </div>

    <div class="mb-4">
      <%= f.label :file, "Reemplazar documento", class: "form-label" %>
      <%= f.file_field :file, class: "form-control", accept: "application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" %>
      <small class="form-text text-muted">
        <% if @acuerdo.files.any? %>
          Documento actual: <strong><%= @acuerdo.files.first.nombre_archivo %></strong> 
          (<%= number_to_human_size(@acuerdo.files.first.byte_size) %>)
        <% else %>
          No hay documento asociado actualmente
        <% end %>
      </small>
    </div>

    <div class="mb-4">
      <%= f.label :user_ids, "Firmantes del acuerdo", class: "form-label" %>
      <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
        <%= collection_check_boxes(:acuerdo, :user_ids, User.all, :id, :name) do |b| %>
          <div class="form-check">
            <%= b.check_box(
              class: "form-check-input", 
              checked: @acuerdo.acuerdo_firmas.pluck(:user_id).include?(b.object.id)
            ) %>
            <%= b.label(class: "form-check-label") do %>
              <%= b.object.name %> - <%= b.object.email %>
            <% end %>
          </div>
        <% end %>
      </div>
      <small class="form-text text-muted">
        Actualmente hay <%= @acuerdo.acuerdo_firmas.count %> firmante(s) asignado(s).
      </small>
    </div>

    

    <div class="d-flex gap-2">
      <%= f.submit "Guardar cambios y notificar", class: "btn btn-primary", 
          data: { confirm: "¿Estás seguro? Esto reiniciará todas las firmas y notificará a los firmantes." } %>
      <%= link_to "Cancelar", @acuerdo, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>


