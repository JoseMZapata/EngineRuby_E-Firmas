<h1>Detalles del Acuerdo</h1>

<div class="card mb-4 p-3 shadow-sm">
  <h3><%= @acuerdo.name %></h3>
  <p><strong>Creado por:</strong> 
    <%= @acuerdo.usuario_creador&.name || "Usuario desconocido" %>
  </p>
  <p><strong>Fecha de creación:</strong> <%= @acuerdo.created_at.strftime("%d/%m/%Y %H:%M") %></p>
</div>

<% if @acuerdo.files.present? %>
    <div class="card mb-4 p-3 shadow-sm">
        <h4>Archivo del acuerdo</h4>

        <% file = @acuerdo.files.first %>

        <% if file %>
            <p><strong>Nombre:</strong> <%= file.nombre_archivo %></p>
            <p><strong>Tamaño:</strong> <%= number_to_human_size(file.byte_size) %></p>
            
            <% download_link = link_to "Descarga el PDF aquí", archivo_acuerdo_path(@acuerdo, disposition: 'attachment') %>

            <iframe src="<%= archivo_acuerdo_path(@acuerdo) %>" width="100%" height="600px" style="border: 1px solid #ccc;">
            Tu navegador no soporta la visualización de PDFs. <%= download_link %>.
            </iframe>
            <% else %>
            <p>Este acuerdo no tiene ningún archivo asociado.</p>
        <% end %>
    </div>
<% else %>
  <p class="text-danger">No hay archivo asociado a este acuerdo.</p>
<% end %>

<div class="card p-3 shadow-sm">
  <h4>Usuarios que deben firmar este acuerdo</h4>
  <table class="table mt-3">
    <thead>
      <tr>
        <th>Usuario</th>
        <th>Estado</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% @acuerdo.acuerdo_firmas.each do |af| %>
        <tr>
          <td><%= af.user.name %></td>
          <td>
            <% if af.firma_id.present? %>
              <span class="badge bg-success">Firmado</span>
            <% else %>
              <span class="badge bg-warning text-dark">Pendiente</span>
            <% end %>
          </td>
          <td>
            <% if af.firma_id.nil? %>
              <%= link_to "Firmar ahora", new_firma_path(acuerdo_id: @acuerdo.id), class: "btn btn-sm btn-primary" %>
           <%#  <% else %>
              <%# <%= link_to "Ver firma", firma_path(af.firma_id), class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

